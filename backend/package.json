{
  "name": "ciclometrics-backend",
  "version": "1.7.1",
  "description": "Backend API y motor de cálculo físico-mecánico para CicloMetrics Web",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node tests/verifyCalculations.js && node tests/verifyApiEndpoints.js && node tests/verifyLoadTesting.js",
    "test:calc": "node tests/verifyCalculations.js",
    "test:api": "node tests/verifyApiEndpoints.js",
    "test:load": "node tests/verifyLoadTesting.js"
  },
  "keywords": [
    "cycling",
    "metrics",
    "met",
    "calories",
    "tire-pressure",
    "elevation",
    "gps"
  ],
