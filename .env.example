# ============================================================================
# VARIABLES DE ENTORNO — CICLOMETRICS WEB (LOCAL Y VERCEL)
# ============================================================================

# 1. Base de Datos MongoDB Atlas (Requerida para producción en Vercel)
# Reemplaza <usuario>, <password> y <cluster> con las credenciales de tu clúster MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=CicloMetrics
MONGODB_DB_NAME=ciclometrics

# 2. Configuración del Servidor Backend
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*
